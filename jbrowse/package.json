{
  "name": "jbrowse-lk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm ci",
    "build": "npm run build-dev",
    "start": "cross-env NODE_ENV=development rspack serve --config node_modules/@labkey/build/configs/watch.config.js",
    "start-link": "cross-env LINK=true npm run start",
    "build-dev": "npm run clean && cross-env NODE_ENV=development rspack build --config ./config/dev.config.js",
    "build-prod": "npm run clean && cross-env NODE_ENV=production rspack build --config ./config/prod.config.js",
    "clean": "rimraf resources/web/gen && rimraf resources/web/jbrowse/gen && rimraf resources/views/gen",
    "jb-sea:fetch": "node ./resources/external/fetch-jbrowse-bundle.mjs",
    "jb-sea:build": "node ./resources/external/build-sea.mjs ./resources/external/jbrowse.js",
    "jb-sea": "npm run jb-sea:fetch && npm run jb-sea:build",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@gmod/vcf": "^7.0.0",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^5.13.0",
    "@jbrowse/plugin-canvas": "^4.3.0",
    "@jbrowse/plugin-linear-genome-view": "^4.3.0",
    "@jbrowse/plugin-variants": "^4.3.0",
    "@jbrowse/product-core": "^4.3.0",
    "@jbrowse/react-linear-genome-view2": "^4.3.0",
    "@labkey/api": "^1.52.2",
    "@labkey/components": "^7.48.0",
    "@mui/x-data-grid": "^7.28.1",
    "assert": "^2.1.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "child_process": "^1.0.2",
    "jquery": "^3.7.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "node-polyfill-webpack-plugin": "^4.1.0",
    "path-browserify": "^1.0.1",
    "react": "^18.3.0",
    "react-data-grid": "7.0.0-beta.46",
    "react-dom": "^18.3.0",
    "react-google-charts": "^5.2.1",
    "react-select": "^5.10.1",
    "regenerator-runtime": "^0.14.1",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "uuid": "^14.0.1",
    "vm-browserify": "^1.1.2"
  },
  "devDependencies": {
    "@labkey/build": "^10.0.0",
    "@types/jexl": "^2.3.4",
    "@types/jquery": "^3.5.32",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "rimraf": "^6.0.1",
    "tar": "^7.5.19",
    "typescript": "^5.1.6",
    "unzipper": "^0.12.3"
  }
}
