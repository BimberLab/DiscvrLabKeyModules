<query xmlns="http://labkey.org/data/xml/query">
    <metadata>
        <tables xmlns="http://labkey.org/data/xml">
            <table tableName="Demographics" tableDbType="TABLE" useColumnOrder="true">
                <javaCustomizer class="org.labkey.studies.query.StudiesCustomizer"/>
                <columns>
                    <column columnName="Id">
                        <url />
                    </column>
                    <column columnName="date">
                        <isHidden>true</isHidden>
                        <shownInDetailsView>false</shownInDetailsView>
                    </column>
                    <column columnName="birth">
                        <formatString>Date</formatString>
                        <columnTitle>Birth</columnTitle>
                        <url>/query/executeQuery.view?
                            schemaName=study&amp;
                            query.queryName=Birth&amp;
                            query.Id~eq=${Id}
                        </url>
                    </column>
                    <column columnName="death">
                        <formatString>Date</formatString>
                        <columnTitle>Death</columnTitle>
                        <url>/query/executeQuery.view?
                            schemaName=study&amp;
                            query.queryName=Deaths&amp;
                            query.Id~eq=${Id}
                        </url>
                    </column>
                    <column columnName="objectId">
                        <isHidden>true</isHidden>
                        <shownInDetailsView>false</shownInDetailsView>
                        <isKeyField>true</isKeyField>
                    </column>
                    <column columnName="sex">
                        <columnTitle>Sex</columnTitle>
                    </column>
                    <column columnName="geographic_origin">
                        <columnTitle>Geographic Origin</columnTitle>
                    </column>
                    <column columnName="birth">
                        <columnTitle>Birth</columnTitle>
                    </column>
                    <column columnName="death">
                        <columnTitle>Death</columnTitle>
                    </column>
                    <column columnName="species">
                        <columnTitle>Species</columnTitle>
                    </column>
                    <column columnName="mother">
                        <columnTitle>Mother</columnTitle>
                    </column>
                    <column columnName="father">
                        <columnTitle>Father</columnTitle>
                    </column>
                    <column columnName="calculated_status">
                        <columnTitle>Status</columnTitle>
                    </column>
                </columns>
            </table>
        </tables>
    </metadata>
</query>